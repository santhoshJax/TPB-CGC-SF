<Process name="Product::MyLookupProcess" defaultAction="ShowView" schemaVersion="0.0.0.5">
  <Entry>
    <ProcessContext>
      <Declarations>
        <Declaration name="ProductList" type="LoProductOverview" />
        <Declaration name="SelectedProducts" type="Object" />
      </Declarations>
      <Parameters>
        <Input name="PrdStateType" type="String" />
        <Input name="filterOnlyProducts" type="String" />
      </Parameters>
    </ProcessContext>
    <EntryActions>
      <Action actionType="LOAD" name="GetProductList" type="LoProductOverview">
        <Parameters>
          <Input name="prdStateType" value="ProcessContext::PrdStateType" />
          <Input name="filterOnlyProducts" value="ProcessContext::filterOnlyProducts" />
          <Input name="asoName" value="AsoProductOverview" type="Literal" />
        </Parameters>
        <Return name="ProcessContext::ProductList" />
      </Action>
    </EntryActions>
  </Entry>
  <Body>
    <Actions>
      <Action actionType="VIEW" name="ShowView">
        <UIDescription>Product::MyLookupUI</UIDescription>
        <Events>
          <Event name="itemSelected" action="SelectItem" />
          <Event name="addProducts" action="PrepareSelectedProducts" />
        </Events>
      </Action>
      <Action actionType="LOGIC" name="SelectItem" call="ProcessContext::ProductList.mySelectItem">
        <Parameters>
          <Input name="prdMainPKey" value="Event.pKey" />
        </Parameters>
      </Action>
      <Action name="PrepareSelectedProducts" actionType="LOGIC" call="ProcessContext::ProductList.myPrepareSelectedProducts">
        <Return name="ProcessContext::SelectedProducts" />
        <TransitionTo action="End" />
      </Action>
      <Action actionType="END" name="End">
        <ReturnValues>
          <Return name="ProductPKeys" value="ProcessContext::SelectedProducts" />
        </ReturnValues>
      </Action>
    </Actions>
  </Body>
</Process>