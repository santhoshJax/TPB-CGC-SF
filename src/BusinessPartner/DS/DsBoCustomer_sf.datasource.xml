  </Attributes>
  <Entities>
    <Entity name="Account" alias="" idAttribute="Id" />
    <Entity name="Account_Extension__c" alias="">
      <Join Type="inner">
        <SimpleJoin>
          <Condition leftSideValue="Account_Extension__c.Account__c" comparator="eq" rightSideType="Attribute" rightSideValue="Account.Id" />
        </SimpleJoin>
      </Join>
    </Entity>
    <Entity name="Account" alias="AccountHierarchy">
      <Join Type="left">
        <SimpleJoin>
          <Condition leftSideValue="Account.parentId" comparator="eq" rightSideType="Attribute" rightSideValue="AccountHierarchy.Id" />
        </SimpleJoin>
      </Join>
    </Entity>
    <Entity name="Account" alias="Wholesaler">
      <Join Type="left outer">
        <SimpleJoin>
          <Condition leftSideValue="Wholesaler.Id" comparator="eq" rightSideType="Attribute" rightSideValue="Account.Primary_Wholesaler__c" />
        </SimpleJoin>
      </Join>
    </Entity>
    <Entity name="Account" alias="SecondaryWholesaler">
      <Join Type="left outer">
        <SimpleJoin>
          <Condition leftSideValue="SecondaryWholesaler.Id" comparator="eq" rightSideType="Attribute" rightSideValue="Account.Secondary_Wholesaler__c" />
        </SimpleJoin>
      </Join>
    </Entity>
    <Entity name="User" alias="Owner">
      <Join Type="left outer">
        <SimpleJoin>
          <Condition leftSideValue="Account.OwnerId" comparator="eq" rightSideType="Attribute" rightSideValue="Owner.Id" />
        </SimpleJoin>
      </Join>
    </Entity>
  </Entities>
  <QueryCondition><![CDATA[
   Account.Id = #pKey#
          ]]></QueryCondition>
  <OrderCriteria />
  <Parameters>
    <Parameter name="pKey" type="TEXT" />
  </Parameters>
</DataSource>