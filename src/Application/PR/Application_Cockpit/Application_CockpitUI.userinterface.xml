<UIDescription name="Application::CockpitUI" schemaVersion="0.0.0.5"  simpleEditorOnly="true">
  <Page pagePattern="SingleSectionPage">
    <PageHeader>
      <Bindings>
        <Resource target="title" type="Label" id="CockpitTitle" defaultLabel="Your Day" />
      </Bindings>
      <MenuItems>
        <MenuItem directlyVisible="true" itemId="RefreshCockpit">
          <Bindings>
            <Resource target="Text" type="Label" id="RefreshCockpitId" defaultLabel="Refresh" />
            <Resource target="Icon" type="Image" id="Refresh" />
          </Bindings>
          <Events>
            <ButtonPressedEvent event="refreshCockpitUI" />
          </Events>
        </MenuItem>
      </MenuItems>
    </PageHeader>
    <Section sectionName="masterSection" sectionPattern="SingleAreaSection">
      <Bindings>
        <Resource target="LogoIcon" type="Image" id="LogoSalesforce" />
        <Resource target="AltLogoIcon" type="Image" id="EmptyImage" />
      </Bindings>
      <Area areaName="mainArea" areaPattern="Card">
        <!--Introduced new binding for working with date for cockpit cards -->
        <Bindings>
          <Binding target="CardDate" type="Date" binding="ProcessContext::CardDate" bindingMode="TWO_WAY" />
        </Bindings>
        <NavigationMenuContainer name="CockpitMenu">
          <NavigationMenuItem name="StartOfDayMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="TruckStart" />
              <Resource target="Title" type="Label" id="startOfDayLabelId" defaultLabel="Start of Day" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="StartOfDayMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="executeStartOfDay" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="AgendaMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Calendar_LM" />
              <Resource target="Title" type="Label" id="agendaOverviewLabelId" defaultLabel="Visit Execution" />
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openAgendaOverview" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="TourUser" />
              <Role name="RetailUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="EndOfDayMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="TruckEnd" />
              <Resource target="Title" type="Label" id="endOfDayLabelId" defaultLabel="End of Day" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="EndOfDayMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="executeEndOfDay" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="TourMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Tour" />
              <Resource target="Title" type="Label" id="tourLabelId" defaultLabel="Tour" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="TourMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openTourOverview" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="TruckLoadMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Box" />
              <Resource target="Title" type="Label" id="truckLoadOverviewLabelId" defaultLabel="Inventory" />
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openInventoryOverview" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="TourUser" />
              <Role name="RetailUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="CashMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Money" />
              <Resource target="Title" type="Label" id="cashOverviewId" defaultLabel="Cash" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="CashMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openCashOverview" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="ReplenishmentMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="ClipboardTruck" />
              <Resource target="Title" type="Label" id="replenishmentOverviewId" defaultLabel="Replenishment" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="ReplenishmentMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openReplenishmentOverview" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="CustomerMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="UserTie_LM" />
              <Resource target="Title" type="Label" id="customerOverviewLabelId" defaultLabel="Customer" />
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openCustomerOverview" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="RetailUser" />
              <Role name="PromotionApprover" />
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="OrderMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Clipboard_LM" />
              <Resource target="Title" type="Label" id="orderOverviewLabelId" defaultLabel="Order" />
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openOrderOverview" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="RetailUser" />
              <Role name="PromotionApprover" />
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="CustomerContractsMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Contract_LM" />
              <Resource target="Title" type="Label" id="customerContractsOverviewLabelId" defaultLabel="Contracts" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="ContractMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openCustomerContracts" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="ReservedForFutureUse_RetailUser" />
              <Role name="ReservedForFutureUse_PromotionApprover" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="PaymentsMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Money" />
              <Resource target="Title" type="Label" id="PaymentsLabelId" defaultLabel="Payments" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="PaymentMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openPayments" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="ReservedForFutureUse_RetailUser" />
              <Role name="ReservedForFutureUse_PromotionApprover" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="PersonalSettingsMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Usrsettings" />
              <Resource target="Title" type="Label" id="PersonalSettingsLabelId" defaultLabel="My Settings" />
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openUsrSettings" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="RetailUser" />
              <Role name="PromotionApprover" />
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="SynchronizeMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Synchronize" />
              <Resource target="Title" type="Label" id="synchronizeLabelId" defaultLabel="Synchronize" />
              <Binding type="Visible" target="Visible" call="ProcessContext::CardController.getCockpitMenuVisibility">
                <Parameters>
                  <Input name="token" type="Literal" value="SyncMenu" />
                </Parameters>
              </Binding>
            </Bindings>
            <Events>
              <ButtonPressedEvent event="synchronizeData" />
            </Events>
            <VisibilityRoles allRoles="false">
              <Role name="RetailUser" />
              <Role name="PromotionApprover" />
              <Role name="TourUser" />
            </VisibilityRoles>
          </NavigationMenuItem>
          <NavigationMenuItem name="AboutMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Info" />
              <Resource target="Title" type="Label" id="AboutLabelId" defaultLabel="About" />
            </Bindings>
            <Events>
              <ButtonPressedEvent event="openAboutScreen" />
            </Events>
            <VisibilityRoles allRoles="true" />
          </NavigationMenuItem>
          <NavigationMenuItem name="LogoutMenuItem">
            <Bindings>
              <Resource target="Image" type="Image" id="Logout" />
              <Resource target="Title" type="Label" id="LogoutLabelId" defaultLabel="Logout" />
            </Bindings>
            <Events>
              <ButtonPressedEvent event="User_Logout" />
            </Events>
            <VisibilityRoles allRoles="true" />
          </NavigationMenuItem>
        </NavigationMenuContainer>
        <!-- User Welcome Card-->
        <CardContainer name="CardUserWelcome">
          <Bindings>
            <Binding type="Visible" target="Visible" call="ProcessContext::CardController.isCardVisible">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardUserWelcome" />
              </Parameters>
            </Binding>
            <Binding type="Text" target="IsCollapsible" call="ProcessContext::CardController.isCardCollapsible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardUserWelcome" />
              </Parameters>
            </Binding>
            <Resource target="Title" type="Label" id="UserWelcomeCardTitle" defaultLabel="Summary" />
            <Binding target="Information" type="Text" binding="ProcessContext::CardController.cardUserWelcome_DateText" bindingMode="ONE_WAY" />
            <Binding target="CollapseState" type="Text" binding="ProcessContext::CardController.CollapseState_CardUserWelcome" bindingMode="TWO_WAY" />
            <Binding target="IsReadyToLoad" type="Text" binding="ProcessContext::CardUserWelcome_DataLoaded" bindingMode="ONE_WAY" />
          </Bindings>
          <VisibilityRoles allRoles="true" />
          <Events>
            <LoadContainerData event="CardUserWelcome_loadData" />
          </Events>
          <CardEventSubcription>
            <CardEvent name="onDateChange" />
          </CardEventSubcription>
          <UserWelcome name="UserWelcomeCardUiPlugin">
            <Bindings>
              <Binding target="userImage" type="Blob" binding="ApplicationContext::User.profilePicture" />
              <Binding target="userName" type="Text" binding="ApplicationContext::User.name" bindingMode="ONE_WAY" />
              <Resource target="visitsLabel" type="Label" id="VisitsId" defaultLabel="Visits" />
              <Binding target="visitCount" type="Text" binding="ProcessContext::LuCallCount.callCount" bindingMode="ONE_WAY" />
              <Binding target="issuesCount" type="Text" binding="ProcessContext::LuIssueCount.issueCount" bindingMode="ONE_WAY" />
              <Binding target="todosCount" type="Text" binding="ProcessContext::LuTodoCount.todoCount" bindingMode="ONE_WAY" />
              <Resource target="userMessage" type="Label" id="CardUserWelcome_MessageText" defaultLabel="Have a great day." />
              <Binding target="isTourUser" type="Bool" binding="ProcessContext::CardController.isTourUser" />
              <Resource id="NoUser" target="userDefaultImage" type="Image" />
              <Binding target="selectedDate" type="Text" binding="ProcessContext::CardDate" bindingMode="ONE_WAY" />
              <Resource target="previousDayIcon" type="Image" id="ChevronLeft" defaultImage="ChevronLeft" />
              <Resource target="nextDayIcon" type="Image" id="ChevronRight" defaultImage="ChevronRight" />
              <Resource target="previousDayOnTouchIcon" type="Image" id="ChevronLeftPressed" defaultImage="ChevronLeftPressed" />
              <Resource target="nextDayOnTouchIcon" type="Image" id="ChevronRightPressed" defaultImage="ChevronRightPressed" />
              <Resource target="todayIcon" type="Image" id="TodayIcon" defaultImage="TodayIcon" />
              <Resource target="todayLabel" type="Label" id="TodayLabel" defaultLabel="Today" />
            </Bindings>
          </UserWelcome>
        </CardContainer>
        <!-- CardVisits START -->
        <CardContainer name="CardVisits">
          <Bindings>
            <Binding type="Visible" target="Visible" call="ProcessContext::CardController.isCardVisible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardVisits" />
              </Parameters>
            </Binding>
            <Binding type="Text" target="IsCollapsible" call="ProcessContext::CardController.isCardCollapsible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardVisits" />
              </Parameters>
            </Binding>
            <Resource target="Title" type="Label" id="VisitsCardTitle" defaultLabel="Visits for today" />
            <Binding target="Information" type="Text" binding="ProcessContext::CardVisits_InformationText" bindingMode="ONE_WAY" />
            <Binding target="CollapseState" type="Text" binding="ProcessContext::CardController.CollapseState_CardVisits" bindingMode="TWO_WAY" />
            <Binding target="IsReadyToLoad" type="Text" binding="ProcessContext::CardVisits_DataLoaded" bindingMode="ONE_WAY" />
            <Binding target="DisplayedSubcomponentName" type="Text" binding="ProcessContext::CardVisits_DisplayedSubcomponentName" bindingMode="ONE_WAY" />
          </Bindings>
          <VisibilityRoles allRoles="false">
            <Role name="RetailUser" />
            <Role name="TourUser" />
          </VisibilityRoles>
          <Events>
            <LoadContainerData event="CardVisits_loadData" />
          </Events>
          <NoDataMessage name="CardNoDataMessageUiPlugin">
            <Bindings>
              <Resource id="EmptyVisits" target="infoIcon" type="Image" />
              <Binding target="maintext" type="Text" binding="ProcessContext::CardController.cardVisits_emptyMainMessage" bindingMode="ONE_WAY" />
              <Binding target="subtext" type="Text" binding="ProcessContext::CardController.cardVisits_emptySubMessage" bindingMode="ONE_WAY" />
            </Bindings>
          </NoDataMessage>
          <ActionBar>
            <ImageButton name="AddNewVisit">
              <Bindings>
                <Resource target="Text" type="Label" id="AddNewVisitId" defaultLabel="Add new Visit" />
                <Resource target="Image" type="Image" id="Plus" defaultImage="Plus" />
                <Binding type="Visible" target="Visible" call="ProcessContext::CardVisits_VisitList.createButtonEditable" />
              </Bindings>
              <Events>
                <ButtonPressedEvent event="CardVisits_addNewVisitPressed" />
              </Events>
            </ImageButton>
          </ActionBar>
          <CockpitList name="Visits" hasBorder="false" dataSource="ProcessContext::CardVisits_VisitList.Items[]">
            <Items name="Items" itemPattern="CardVisitsItems">
              <ItemListLayout>
                <Default>
                  <Col width="1em" height="1.6em" layoutType="Image" bindingId="typeWithStatusImage" />
                  <Col width="2em" layoutType="itemSecondaryCockpit" bindingId="timeFrom" />
                  <Col flex="1">
                    <Row layoutType="itemIdentifierCockpit" bindingId="customerName" />
                    <Row layoutType="itemSecondaryCockpit" bindingId="customerAddress" />
                  </Col>
                </Default>
                <Tablet>
                  <Default>
                    <Col width="1em" height="1.4em" layoutType="Image" bindingId="typeWithStatusImage" />
                    <Col width="2em" layoutType="itemSecondaryCockpit" bindingId="timeFrom" />
                    <Col flex="1">
                      <Row layoutType="itemIdentifierCockpit" bindingId="customerName" />
                      <Row layoutType="itemSecondaryCockpit" bindingId="customerAddress" />
                    </Col>
                  </Default>
                </Tablet>
                <Phone>
                  <Default>
                    <Col width="2em" height="1.4em" layoutType="Image" bindingId="typeWithStatusImage" />
                    <Col width="3.3em" layoutType="itemSecondaryCockpit" bindingId="timeFrom" />
                    <Col flex="1">
                      <Row layoutType="itemIdentifierCockpit" bindingId="customerName" />
                      <Row layoutType="itemSecondaryCockpit" bindingId="customerAddress" />
                    </Col>
                  </Default>
                </Phone>
              </ItemListLayout>
              <ContextMenu>
                <Bindings>
                  <Binding target="DataSource" binding="ProcessContext::CardVisits_ContextMenuList.Items[]" bindingMode="ONE_WAY" />
                </Bindings>
                <Items name="ContextMenuItems">
                  <Bindings>
                    <Binding target="Icon" type="Image" binding=".actionImg" />
                    <Binding target="Text" type="Label" binding=".actionId" />
                    <Binding type="Editable" target="Editable" binding=".actionEnabled" />
                    <Binding type="Visible" target="Visible" binding=".actionVisible" />
                  </Bindings>
                </Items>
              </ContextMenu>
              <Bindings>
                <Binding target="typeWithStatusImage" type="Image" binding=".clbTypeStatusColoredNew" bindingMode="ONE_WAY" />
                <Binding target="timeFrom" type="Text" binding=".timeFrom" bindingMode="ONE_WAY" />
                <Binding target="customerName" type="Text" binding=".name" bindingMode="ONE_WAY" />
                <Binding target="customerAddress" type="Text" binding=".address" bindingMode="ONE_WAY" />
                <Binding target="customerRecordTypeName" type="Text" binding=".recordTypeName" bindingMode="ONE_WAY" />
              </Bindings>
            </Items>
            <Events>
              <ItemSelectedEvent event="CardVisits_itemSelected">
                <Params>
                  <Param name="pKey" value=".pKey" />
                  <Param name="customerName" value=".name" />
                  <Param name="customerOnDevice" value=".customerOnDevice" />
                  <Param name="recordTypeName" value=".recordTypeName" />
                  <Param name="clbMetaType" value=".clbMetaType" />
                </Params>
              </ItemSelectedEvent>
              <ContextOpeningEvent event="CardVisits_contextMenuOpening">
                <Params>
                  <Param name="pKey" value=".pKey" />
                  <Param name="clbStatus" value=".clbStatus" />
                  <Param name="deleteAllowed" value=".deleteAllowed" />
                  <Param name="isStartVisitRqrToCheckIn" value=".isStartVisitRqrToCheckIn" />
                  <Param name="dateFrom" value=".dateFrom" />
                  <Param name="bpaMainPKey" value=".bpaMainPKey" />
                  <Param name="responsiblePKey" value=".responsiblePKey" />
                  <Param name="clbMetaType" value=".clbMetaType" />
                </Params>
              </ContextOpeningEvent>
              <ContextSelectedEvent event="CardVisits_contextMenuItemSelected">
                <Params>
                  <Param name="pKey" value=".pKey" />
                  <Param name="dateFrom" value=".dateFrom" />
                  <Param name="timeFrom" value=".timeFrom" />
                  <Param name="dateThru" value=".dateThru" />
                  <Param name="timeThru" value=".timeThru" />
                  <Param name="customerOnDevice" value=".customerOnDevice" />
                  <Param name="recordTypeName" value=".recordTypeName" />
                </Params>
              </ContextSelectedEvent>
            </Events>
          </CockpitList>
          <LinkBar>
            <ImageButton name="CalendarLink">
              <Bindings>
                <Resource target="Text" type="Label" id="ShowCalendarLink" defaultLabel="Show Call Calendar" bindingMode="ONE_WAY" />
                <Resource target="Image" type="Image" id="Calendar_HB" defaultImage="Calendar_HB" />
              </Bindings>
              <Events>
                <ButtonPressedEvent event="CardVisits_showCallCalendar" />
              </Events>
            </ImageButton>
          </LinkBar>
          <CardEventSubcription>
            <CardEvent name="onDateChange" />
          </CardEventSubcription>
        </CardContainer>
        <!-- Reporting Card -->
        <CardContainer name="CardReporting">
          <Bindings>
            <Binding type="Visible" target="Visible" call="ProcessContext::CardController.isCardVisible">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardReporting" />
              </Parameters>
            </Binding>
            <Binding type="Text" target="ShowMaximizeButton" call="ProcessContext::CardController.isCardMaximizable">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardReporting" />
              </Parameters>
            </Binding>
            <Binding type="Text" target="IsCollapsible" call="ProcessContext::CardController.isCardCollapsible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardReporting" />
              </Parameters>
            </Binding>
            <Resource target="Title" type="Label" id="ReportingCardTitle" defaultLabel="Reporting" />
            <Resource target="Information" type="Label" id="ReportingCardInformation" defaultLabel="All customers" />
            <Binding target="CollapseState" type="Text" binding="ProcessContext::CardController.CollapseState_CardReporting" bindingMode="TWO_WAY" />
            <Binding target="IsReadyToLoad" type="Text" binding="ProcessContext::CardReporting_DataLoaded" bindingMode="ONE_WAY" />
          </Bindings>
          <VisibilityRoles allRoles="false">
            <Role name="RetailUser" />
            <Role name="TourUser" />
          </VisibilityRoles>
          <Events>
            <ButtonPressedEvent event="CardReportingSales_showMaximizedReport" />
            <LoadContainerData event="CardReporting_loadData" />
          </Events>
          <UIPluginV2 name="CardReportingUiPlugin" uiPlugin="CardReportingUiPluginV2">
            <Bindings>
              <Binding target="mode" type="Text" binding="ProcessContext::Mode" bindingMode="ONE_WAY" />
              <Binding target="unsuccessfulVisitRate" type="Text" binding="ProcessContext::CardReportingUnsuccessfulVisits_Rate" bindingMode="ONE_WAY" />
              <Binding target="visitRate" type="Text" binding="ProcessContext::CardReportingVisitRate_Rate" bindingMode="ONE_WAY" />
              <Binding target="selectedDate" type="Text" binding="ProcessContext::CardDate" bindingMode="ONE_WAY" />
              <Binding target="currentDate" type="Text" binding="ProcessContext::CurrentDate" bindingMode="ONE_WAY" />
              <Binding target="currency" type="Text" binding="ApplicationContext::User.translatedCurrency" bindingMode="ONE_WAY" />
              <List target="salesData" dataSource="ProcessContext::CardReportingSales_SalesData.Items[]">
                <Binding target="pKey" type="Text" binding=".pKey" />
                <Binding target="netSales" type="Text" binding=".netSales" />
                <Binding target="year " type="Text" binding=".year" />
                <Binding target="month" type="Text" binding=".month" />
              </List>
            </Bindings>
          </UIPluginV2>
          <CardEventSubcription>
            <CardEvent name="onDateChange" />
          </CardEventSubcription>
        </CardContainer>
        <!-- Activities Card -->
        <!-- Visits Guide START -->
        <!-- Mobile Links Card-->
        <CardContainer name="CardMobileLinks">
          <Bindings>
            <Binding type="Visible" target="Visible" call="ProcessContext::CardController.isCardVisible">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardMobileLinks" />
              </Parameters>
            </Binding>
            <Binding type="Text" target="IsCollapsible" call="ProcessContext::CardController.isCardCollapsible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardMobileLinks" />
              </Parameters>
            </Binding>
            <Resource target="Title" type="Label" id="MobileLinksCardTitle" defaultLabel="CRM Analytics" />
            <Binding target="Information" type="Text" binding="ProcessContext::CardQuickAccess_InformationText" bindingMode="ONE_WAY" />
            <Binding target="IsReadyToLoad" type="Text" binding="ProcessContext::CardQuickAccess_DataLoaded" bindingMode="ONE_WAY" />
            <Binding target="CollapseState" type="Text" binding="ProcessContext::CardController.collapseState_CardQuickAccess" bindingMode="TWO_WAY" />
            <Binding target="DisplayedSubcomponentName" type="Text" binding="ProcessContext::CardQuickAccess_DisplayedSubcomponentName" bindingMode="ONE_WAY" />
          </Bindings>
          <VisibilityRoles allRoles="true" />
          <Events>
            <LoadContainerData event="CardQuickAccess_loadData" />
          </Events>
          <NoDataMessage name="CardNoDataMessageUiPlugin">
            <Bindings>
              <Resource target="maintext" type="Label" id="CardQuickAccess_NoDataMessageMainText" defaultLabel="No quick links were defined for you yet" />
              <!--Place holder image will be updated-->
              <Resource id="EmptyAccess" target="infoIcon" type="Image" />
            </Bindings>
          </NoDataMessage>
          <CockpitList name="QuickAccess" hasBorder="false" dataSource="ProcessContext::CardQuickAccess_List.Items[]">
            <Items name="Items" itemPattern="CardQuickAccessItems">
              <ItemListLayout>
                <Default>
                  <Col width="1em" height="1.6em" layoutType="Image" bindingId="imageNavigate" />
                  <Col flex="1">
                    <Row layoutType="itemIdentifierCockpit" bindingId="description" />
                  </Col>
                </Default>
                <Tablet>
                  <Default>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="imageNavigate" />
                    <Col flex="1">
                      <Row layoutType="itemIdentifierCockpit" bindingId="description" />
                    </Col>
                  </Default>
                  <Windows>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="imageNavigate" />
                    <Col flex="1">
                      <Row layoutType="itemIdentifierCockpit" bindingId="description" />
                    </Col>
                  </Windows>
                </Tablet>
                <Phone>
                  <Default>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="imageNavigate" />
                    <Col flex="1">
                      <Row layoutType="itemIdentifierCockpit" bindingId="description" />
                    </Col>
                  </Default>
                </Phone>
              </ItemListLayout>
              <Bindings>
                <Binding target="imageNavigate" type="Image" id="Navigate" defaultImage="Navigate" bindingMode="ONE_WAY" />
                <Binding target="description" type="Text" binding=".description" bindingMode="ONE_WAY" />
                <Binding target="mediaPath" type="Blob" binding=".mediaPath" fileTypeBinding=".fileType" />
              </Bindings>
            </Items>
            <Events>
              <ItemSelectedEvent event="CardQuickAccess_itemSelected">
                <Params>
                  <Param name="schemeName" value=".schemeName" />
                  <Param name="url" value=".url" />
                </Params>
              </ItemSelectedEvent>
            </Events>
          </CockpitList>
        </CardContainer>
        <!-- Quick Access Card-->
        <!-- Notifications Card-->
        <!-- Customer Tasks Card -->
        <CardContainer name="CardCustomerTasks">
          <Bindings>
            <Binding type="Visible" target="Visible" call="ProcessContext::CardController.isCardVisible">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardCustomerTasks" />
              </Parameters>
            </Binding>
            <Binding type="Text" target="IsCollapsible" call="ProcessContext::CardController.isCardCollapsible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardCustomerTasks" />
              </Parameters>
            </Binding>
            <Resource target="Title" type="Label" id="CustomerTasksCardTitle" defaultLabel="Customer Tasks Today" />
            <Binding target="IsReadyToLoad" type="Text" binding="ProcessContext::CardCustomerTasks_DataLoaded" bindingMode="ONE_WAY" />
            <Binding target="CollapseState" type="Text" binding="ProcessContext::CardController.CollapseState_CardCustomerTasks" bindingMode="TWO_WAY" />
            <Binding target="DisplayedSubcomponentName" type="Text" binding="ProcessContext::CardCustomerTasks_DisplayedSubcomponentName" bindingMode="ONE_WAY" />
          </Bindings>
          <VisibilityRoles allRoles="false">
            <Role name="RetailUser" />
          </VisibilityRoles>
          <Events>
            <LoadContainerData event="CardCustomerTasks_loadData" />
          </Events>
          <CardEventSubcription>
            <CardEvent name="onDateChange" />
          </CardEventSubcription>
          <NoDataMessage name="CardNoDataMessageUiPlugin">
            <Bindings>
              <Binding target="maintext" type="Text" binding="ProcessContext::CardController.cardCustomerTasks_emptyMainMessage" bindingMode="ONE_WAY" />
              <Binding target="subtext" type="Text" binding="ProcessContext::CardController.cardCustomerTasks_emptySubMessage" bindingMode="ONE_WAY" />
              <Resource id="Done" target="infoIcon" type="Image" />
            </Bindings>
          </NoDataMessage>
          <ActionBar>
            <ImageButton name="AddNewCustomerTask">
              <Bindings>
                <Resource target="Text" type="Label" id="AddNewCustomerTaskId" defaultLabel="Add new Customer Task" />
                <Resource target="Image" type="Image" id="Plus" defaultImage="Plus" />
              </Bindings>
              <Events>
                <ButtonPressedEvent event="CardCustomerTasks_addNewTaskPressed" />
              </Events>
            </ImageButton>
          </ActionBar>
          <CockpitList name="CustomerTasks" hasBorder="false" dataSource="ProcessContext::CardCustomerTasks_TasksList.Items[]">
            <Items name="Items" itemPattern="CardCustomerTasksItems">
              <ItemListLayout>
                <Default>
                  <Col width="1em" height="1.6em" layoutType="Image" bindingId="classificationImage" />
                  <Col flex="1">
                    <Row layoutType="itemIdentifierCockpit" bindingId="text" />
                    <Row layoutType="itemSecondaryCockpit" bindingId="customerName" />
                  </Col>
                  <Col width="1em" height="1.6em" layoutType="Image" bindingId="priorityImage" />
                </Default>
                <Tablet>
                  <Default>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="classificationImage" />
                    <Col flex="1">
                      <Row layoutType="itemIdentifierCockpit" bindingId="text" />
                      <Row layoutType="itemSecondaryCockpit" bindingId="customerName" />
                    </Col>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="priorityImage" />
                  </Default>
                  <Windows>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="classificationImage" />
                    <Col width="20em">
                      <Row layoutType="itemIdentifierCockpit" bindingId="text" />
                      <Row layoutType="itemSecondaryCockpit" bindingId="customerName" />
                    </Col>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="priorityImage" />
                  </Windows>
                </Tablet>
                <Phone>
                  <Default>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="classificationImage" />
                    <Col flex="1">
                      <Row layoutType="itemIdentifierCockpit" bindingId="text" />
                      <Row layoutType="itemSecondaryCockpit" bindingId="customerName" />
                    </Col>
                    <Col width="1em" height="1.6em" layoutType="Image" bindingId="priorityImage" />
                  </Default>
                </Phone>
              </ItemListLayout>
              <ContextMenu>
                <Bindings>
                  <Binding target="DataSource" binding="ProcessContext::CardCustomerTasks_ContextMenuList.Items[]" bindingMode="ONE_WAY" />
                </Bindings>
                <Items name="ContextMenuItems">
                  <Bindings>
                    <Binding target="Icon" type="Image" binding=".actionImg" />
                    <Binding target="Text" type="Label" binding=".actionId" />
                    <Binding type="Editable" target="Editable" binding=".actionEnabled" />
                  </Bindings>
                </Items>
              </ContextMenu>
              <Bindings>
                <Binding target="text" type="Text" binding=".text" bindingMode="ONE_WAY" />
                <Binding target="customerName" type="Text" binding=".customerName" bindingMode="ONE_WAY" />
                <Binding target="classificationImage" type="Image" binding=".classificationImage" bindingMode="ONE_WAY" />
                <Binding target="priorityImage" type="Image" binding=".priorityImage" bindingMode="ONE_WAY" />
                <Binding target="dueDate" type="Text" binding=".dueDate" bindingMode="ONE_WAY" />
              </Bindings>
            </Items>
            <Events>
              <ItemSelectedEvent event="CardCustomerTasks_itemSelected">
                <Params>
                  <Param name="pKey" value=".pKey" />
                </Params>
              </ItemSelectedEvent>
              <ContextOpeningEvent event="CardCustomerTasks_contextMenuOpening">
                <Params>
                  <Param name="pKey" value=".pKey" />
                  <Param name="issuePhase" value=".issuePhase" />
                  <Param name="responsiblePKey" value=".responsiblePKey" />
                  <Param name="initiatorPKey" value=".initiatorPKey" />
                  <Param name="isPrivate" value=".isPrivate" />
                  <Param name="wfeWorkflowPKey" value=".wfeWorkflowPKey" />
                  <Param name="actualStatePKey" value=".actualStatePKey" />
                  <Param name="substitutionStatus" value=".substitutionStatus" />
                  <Param name="isActive" value=".isActive" />
                  <Param name="svcMetaPKey" value=".svcMetaPKey" />
                </Params>
              </ContextOpeningEvent>
              <ContextSelectedEvent event="CardCustomerTasks_contextMenuItemSelected">
                <Params>
                  <Param name="pKey" value=".pKey" />
                </Params>
              </ContextSelectedEvent>
            </Events>
          </CockpitList>
          <LinkBar>
            <ImageButton name="AllCustomerTasksLink">
              <Bindings>
                <Resource target="Text" type="Label" id="AllCustomerTasksLink" defaultLabel="All Customer Tasks" bindingMode="ONE_WAY" />
                <Resource target="Image" type="Image" id="Bolt_HB" defaultImage="Bolt_HB" />
              </Bindings>
              <Events>
                <ButtonPressedEvent event="CardCustomerTasks_showAllTasks" />
              </Events>
            </ImageButton>
          </LinkBar>
        </CardContainer>
        <!-- Tasks Card-->
        <!-- Customer Overdue Card-->
        <!-- Sync Card -->
        <SyncCardContainer name="cardSync">
          <Bindings>
            <Binding type="Visible" target="Visible" call="ProcessContext::CardController.isCardVisible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardSync" />
              </Parameters>
            </Binding>
            <Binding type="Text" target="IsCollapsible" call="ProcessContext::CardController.isCardCollapsible" bindingMode="ONE_WAY">
              <Parameters>
                <Input name="cardName" type="Literal" value="CardSync" />
              </Parameters>
            </Binding>
            <Resource target="Title" type="Label" id="SyncCardTitle" defaultLabel="Sync Status" />
            <Binding target="CollapseState" type="Text" binding="ProcessContext::CardController.CollapseState_CardSync" bindingMode="TWO_WAY" />
          </Bindings>
          <VisibilityRoles allRoles="true" />
          <CardEventSubcription>
            <CardEvent name="onAutoReload" intervalInSeconds="10" />
          </CardEventSubcription>
        </SyncCardContainer>
      </Area>
    </Section>
  </Page>
</UIDescription>