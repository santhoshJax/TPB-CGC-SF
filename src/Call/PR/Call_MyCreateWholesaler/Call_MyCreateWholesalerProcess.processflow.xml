<Process name="Call::MyCreateWholesalerProcess" defaultAction="ShowView" schemaVersion="0.0.0.5">
  <Entry>
    <ProcessContext>
      <Declarations>
        <Declaration name="AllWholesalerList" type="LoMyCustomerWholesalers" />
        <Declaration name="NewRA" type="LiMyCallRelatedWholesaler" />
        <Declaration name="EventBool" type="DomBool" />
        <Declaration name="CreateDecision" type="String" />
      </Declarations>
      <Parameters>
        <Input name="CallCustomerPKey" type="DomPKey" />
        <Input name="RelatedWholesalerList" type="LoMyCallRelatedWholesaler" />
      </Parameters>
    </ProcessContext>
    <EntryActions>
      <Action actionType="LOAD" name="GetAllWholesalers" type="LoMyCustomerWholesalers">
        <Parameters>
          <Input name="recordTypeName" value="Wholesaler" />
        </Parameters>
        <Return name="ProcessContext::AllWholesalerList" />
      </Action>
    </EntryActions>
  </Entry>
  <Body>
    <Actions>
      <Action actionType="VIEW" name="ShowView">
        <UIDescription>Call::MyCreateWholesalerUI</UIDescription>
        <Events>
          <Event name="itemSelected" action="SelectCheck" />
        </Events>
      </Action>
      <Action name="SelectCheck" actionType="LOGIC" call="Utils.isDefined">
        <Parameters>
          <Input name="value" value="Event.pKey" />
        </Parameters>
        <Return name="ProcessContext::EventBool" />
        <TransitionTo action="EventCheck" />
      </Action>
      <Action name="EventCheck" actionType="DECISION" parameter="ProcessContext::EventBool">
        <Case value="true" action="AddtoRelatedWholesalerList" />
        <CaseElse action="End" />
      </Action>
      <Action actionType="LOGIC" name="AddtoRelatedWholesalerList" call="ProcessContext::RelatedWholesalerList.myAddItem">
        <Parameters>
          <Input name="CallCustomerPKey" value="ProcessContext::CallCustomerPKey" />
          <Input name="NewWholesalerPKey" value="Event.pKey" />
          <Input name="NewWholesalerClearing" value="Event.wholesalerClear" />
          <Input name="NewWholesalerName" value="Event.name" />
        </Parameters>
        <TransitionTo action="AssignCreateDecision" />
        <Return name="ProcessContext::NewRA" />
      </Action>
      <Action name="AssignCreateDecision" actionType="LOGIC" call="Utils.identity">
        <Parameters>
          <Input name="value" value="create" type="Literal" />
        </Parameters>
        <Return name="ProcessContext::CreateDecision" />
        <TransitionTo action="End"/>
      </Action>
      <Action actionType="END" name="End">
        <ReturnValues>
          <Return name="buttonPressed" value="ProcessContext::CreateDecision" />
          <Return name="newRecord" value="ProcessContext::NewRA" />
        </ReturnValues>
      </Action>
    </Actions>
  </Body>
</Process>