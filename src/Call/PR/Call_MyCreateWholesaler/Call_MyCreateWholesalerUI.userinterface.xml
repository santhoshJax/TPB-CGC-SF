<UIDescription name="Call::MyCreateWholesalerUI" schemaVersion="0.0.0.5">
  <Page pagePattern="SingleSectionDialogPage" onBackDiscard="true">
    <PageHeader>
      <Bindings>
        <Resource target="title" type="Label" id="WholesalerCreateNewTitleId" defaultLabel="New Wholesaler" />
      </Bindings>
    </PageHeader>
    <Section sectionName="masterSection" sectionPattern="SingleAreaSection">
      <Area areaName="mainArea" areaPattern="SingleElementArea">
        <GroupedList name="AllWholesalerList" sortBy="name" searchable="true" dataSource="ProcessContext::AllWholesalerList.Items[]">
          <Items name="Items" itemPattern="WholesalerItemCreateNew">
            <Bindings>
              <Binding target="WholesalerName" type="Text" binding=".name" bindingMode="ONE_WAY" />
              <Binding target="Flag" type="Image" binding=".wholesalerClear" bindingMode="ONE_WAY" />
            </Bindings>
            <ItemListLayout>
              <Col layoutType="itemIdentifier" bindingId="WholesalerName" />
              <Col layoutType="Image" width="1em" bindingId="Flag" />
            </ItemListLayout>
          </Items>
          <Events>
            <ItemSelectedEvent event="itemSelected">
              <Params>
                <Param name="pKey" value=".pKey" />
                <Param name="wholesalerClear" value=".wholesalerClear" />
                <Param name="name" value=".name" />
              </Params>
            </ItemSelectedEvent>
          </Events>
          <SearchAttributes>
            <SearchAttribute name="name" />
          </SearchAttributes>
        </GroupedList>
      </Area>
    </Section>
  </Page>
</UIDescription>