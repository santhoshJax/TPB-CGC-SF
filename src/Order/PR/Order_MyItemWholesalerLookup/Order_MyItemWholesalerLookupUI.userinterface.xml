<UIDescription name="Order::MyItemWholesalerLookupUI" schemaVersion="0.0.0.5">
  <Page pagePattern="SingleSectionDialogPage" navigation="Off" onBackDiscard="true">
    <PageHeader>
      <Bindings>
        <Resource target="title" type="Label" id="OrderItemWholesalerLookup" defaultLabel="Wholesaler Lookup" bindingMode="ONE_TIME" />
      </Bindings>
    </PageHeader>
    <Section sectionName="masterSection" sectionPattern="SingleAreaSection">
      <Area areaName="mainArea" areaPattern="SingleElementArea">
        <GroupedList name="WholesalerList" indexBar="true" searchable="true" sortBy="wholesaler" dataSource="ProcessContext::Wholesalers.Items[]">
          <Items name="Items" itemPattern="CustomerLookupItem">
            <Bindings>
              <Binding target="SKU" type="Text" binding=".sku" bindingMode="ONE_WAY" />
              <Binding target="Wholesaler" type="Text" binding=".wholesaler" bindingMode="ONE_WAY" />
              <Resource target="SKULabel" type="Label" id="SKULabelId" defaultLabel="Wholesale Order Code" />
            </Bindings>
            <ItemListLayout>
              <Col>
                <Row layoutType="itemIdentifier" bindingId="Wholesaler" />
                <Row>
                  <Col width="12em" layoutType="itemSecondary" bindingId="SKULabel" />
                  <Col layoutType="itemSecondary" bindingId="SKU"  />
                </Row>
              </Col>
            </ItemListLayout>
          </Items>
          <Events>
            <ItemSelectedEvent event="itemSelected">
              <Params>
                <Param name="wpId" value=".APpKey" />
                <Param name="wpSKU" value=".sku" />
                <Param name="wId" value=".wholesalerPKey" />
                <Param name="wName" value=".wholesaler" />
                <Param name="supplierId" value=".supplierId" />
              </Params>
            </ItemSelectedEvent>
          </Events>
          <SearchAttributes>
            <SearchAttribute name="wholesaler" />
          </SearchAttributes>
        </GroupedList>
      </Area>
    </Section>
  </Page>
</UIDescription>